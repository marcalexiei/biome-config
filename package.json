{
  "name": "@marcalexiei/biome-config",
  "version": "3.0.0",
  "description": "Custom BiomeJS config",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "biome",
    "biomejs",
    "lint",
    "format",
    "config"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/biome-config"
  },
  "author": "Marco Pasqualetti @marcalexiei",
  "license": "MIT",
  "exports": {
    "./base": "./configs/base.json",
    "./css": "./configs/css.json",
    "./react": "./configs/react.json"
  },
  "files": [
    "configs"
  ],
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "format": "biome format",
    "format:fix": "biome format --fix",
    "format:tests": "pnpm -r exec biome format",
    "format:tests:fix": "pnpm -r exec biome format --fix",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "test": "pnpm --workspace-concurrency=1 --filter=\"tests-*\" run test",
    "release": "changeset publish",
    "validate": "pnpm run \"/^(lint|test|format|format:tests)$/\"",
    "check-rules-configuration": "node ./scripts/check-rules-configuration.ts "
  },
  "peerDependencies": {
    "@biomejs/biome": "2.3.x"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@types/node": "26.6.6",
    "lefthook": "2.0.4"
  }
}
